create table leitores(
	id serial primary key,
	nome varchar(100) not null,
	email varchar(200) unique not null,
	cpf varchar(11) unique not null,
	telefone varchar(20) not null,
	data_cadastro timestamp default current_timestamp
);
create table categorias (
	id serial primary key,
	nome varchar(100) unique not null
);
create table livros(
	id serial primary key,
	categoria_id int references categorias(id),
	titulo varchar(100) not null,
	isbn varchar(10) unique not null,
	taxa_diaria decimal(10, 2) not null check(taxa_diaria > 0),
	disponivel boolean default true
);
create table emprestimos(
	id serial primary key,
	leitor_id int references leitores(id),
	data_emprestimo timestamp default current_timestamp,
	status varchar(100) default 'Ativo' check(status in('Ativo', 'Devolvido', 'Atrasado'))
);
create table itens_emprestimo(
	id serial primary key,
	emprestimo_id int references emprestimos(id),
	livro_id int references livros(id),
	quantidade int not null check(quantidade > 0)
);


