create view vw_acervo_ordenado as

select
	lv.titulo,
	lv.isbn,
	c.nome,
	lv.taxa_diaria
from
	livros lv
join
	categorias c on c.id = lv.categoria_id
order by
	lv.taxa_diaria asc;

create view vw_emprestimos_carlos as

select
	lt.nome,
	e.id,
	e.data_emprestimo,
	lv.titulo,
	ie.quantidade,
	e.status
from
	emprestimos e
join
	leitores lt on lt.id = e.leitor_id
join
	itens_emprestimo ie on e.id = ie.emprestimo_id
join
	livros lv on lv.id = ie.livro_id

where
	lt.nome = 'Carlos Silva'

create view vw_total_emprestimos as

select
	e.id,
	lt.nome,
	SUM(ie.quantidade * lv.taxa_diaria) as valor_total
from
	emprestimos e
join
	itens_emprestimo ie on e.id = ie.emprestimo_id
join
	leitores lt on lt.id = e.leitor_id
join
	livros lv on lv.id = ie.livro_id
group by
	e.id, lt.nome

select
	c.nome,
	lv.titulo,
	lv.taxa_diaria,
	lv.disponivel
from
	livros lv
join
	itens_emprestimo ie on lv.id = ie.livro_id
join
	categorias c on c.id = lv.categoria_id
where
	c.nome = 'Ficção'
	and
	lv.taxa_diaria > 5.00
	and
	lv.disponivel = true

create view vw_faturamento_por_categoria as

select 
	c.nome as categoria, 
	sum(ie.quantidade * ie.valor_diaria) as faturamento_total

from 
	itens_emprestimo ie
join 
	emprestimos emp on ie.emprestimo_id = emp.id
join
	livros l on ie.livro_id = l.id
join
	categorias c on l.categoria_id = c.id
where emp.status = 'Devolvido'
group by c.nome;
